# KipuBankV2 - Variables de Entorno
# Copia este archivo a .env y completa los valores

# Clave privada de tu wallet (SIN el prefijo 0x)
PRIVATE_KEY=tu_private_key_aqui

# RPC URL para Sepolia
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/tu_api_key_infura

# API Key de Etherscan para verificación
ETHERSCAN_API_KEY=tu_etherscan_api_key

# Contract deployment parameters (Sepolia)
TOTAL_CAP_USD=1000000000000  # $1M in 6 decimals
WITHDRAWAL_LIMIT_USD=10000000000  # $10K in 6 decimals
ADMIN_ADDRESS=0x...
ETH_PRICE_FEED_SEPOLIA=0x694AA1769357215DE4FAC081bf1f309aDC325306

# Contract deployment parameters (Mainnet)
ETH_PRICE_FEED_MAINNET=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419